import Random              # loads your random feature; without it, Random{} can't exist

# three outcomes, weights 52 + 31 + 17 = 100 → the runtime picks exactly one
define Random value{1} = 52   # the "even step" face of Random
define Random value{2} = 31   # the "odd step" face of Random
define Random value{3} = 17   # the "already finished" face of Random

# variables, declared before use; {1} is the single slot each one holds
define N value{1} = 27        # N is the number we're walking down
define Steps value{1} = 1     # how many terms we've counted so far

N{1} = 27                     # store 27; the right side is a constant, never N itself
Steps{1} = 1                  # reset the counter to 1, because 27 already counts

Random{1} = print ("even: 27 / 2 = 13")     # runs when Random{1} wins the draw
Random{2} = print ("odd: 27 * 3 + 1 = 82")  # runs when Random{2} wins the draw
Random{3} = print ("chain length of 27 is 111")  # runs when Random{3} wins

end                           # closes the block; nothing after this run

