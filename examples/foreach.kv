# for each walks a list and gives you one item at a time.
define pets = ["cat", "dog", "fox"]

for each pet in pets
  print "I have a" pet

# The same word works on a text, one letter at a time.
for each letter in "ciao"
  print letter

# stop early with break
for each number in [3, 6, 9, 12]
  if number > 6 = break
  print number
end
